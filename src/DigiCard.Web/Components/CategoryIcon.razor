@* Line icons for the six ceremony categories.

   Drawn on a 24×24 grid with a single stroke weight so the row reads as one set. They use
   currentColor, so the card's hover and focus states carry straight through without extra
   rules. Original drawings - the motifs (rings, the sofreh mirror, boteh) are traditional,
   the shapes are ours. *@

<svg class="cat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"
     role="presentation" focusable="false" aria-hidden="true">
    @switch (Slug)
    {
        case "wedding":
            @* Two joined rings. *@
            <circle cx="9.5" cy="14.5" r="5.2" />
            <circle cx="14.5" cy="14.5" r="5.2" />
            <path d="M12 5.5v1.8M9.6 6.4l.7 1.5M14.4 6.4l-.7 1.5" opacity=".7" />
            break;

        case "aghd":
            @* The sofreh mirror between two candles. *@
            <path d="M8 19.5v-7.2a4 4 0 0 1 8 0v7.2z" />
            <path d="M9.6 19.5h4.8" />
            <path d="M4.5 19.5v-5.2M19.5 19.5v-5.2" />
            <path d="M4.5 12.6V11M19.5 12.6V11" opacity=".7" />
            break;

        case "engagement":
            @* A single ring with its stone. *@
            <circle cx="12" cy="15.4" r="4.8" />
            <path d="M12 8.4 9.3 5.6h5.4z" />
            <path d="M9.3 5.6h5.4" opacity=".7" />
            break;

        case "baleboron":
            @* A small posy, the gift carried to the asking. *@
            <circle cx="12" cy="7.6" r="2.3" />
            <circle cx="7.8" cy="10.8" r="2.1" />
            <circle cx="16.2" cy="10.8" r="2.1" />
            <path d="M12 10.4v8.6M9.4 13.2 12 15.6M14.6 13.2 12 15.6" />
            break;

        case "hanabandan":
            @* Boteh, the motif henna is drawn in. *@
            <path d="M12 20c-4.2-2.6-6-6.4-4.4-10C9 6.4 12.4 4.3 15 4c2-.2 3.4 1.1 3.4 2.9 0 1.9-1.7 3.2-3.4 2.7" />
            <circle cx="11" cy="14.2" r=".9" fill="currentColor" stroke="none" opacity=".75" />
            <circle cx="13.4" cy="10.8" r=".7" fill="currentColor" stroke="none" opacity=".55" />
            break;

        case "anniversary":
            @* A heart held in a laurel. *@
            <path d="M12 19.2s-5.2-3.4-5.2-7a3 3 0 0 1 5.2-2 3 3 0 0 1 5.2 2c0 3.6-5.2 7-5.2 7z" />
            <path d="M4.6 13.4A8.4 8.4 0 0 1 8 6.6M19.4 13.4A8.4 8.4 0 0 0 16 6.6" opacity=".7" />
            break;

        case "memorial":
            @* A cypress, the tree Persian gravestones carry, with a resting candle flame. *@
            <path d="M12 20.5v-2.4" />
            <path d="M12 3.6c2.5 2.6 3.8 5.6 3.8 8.8 0 3.4-1.7 5.7-3.8 5.7s-3.8-2.3-3.8-5.7c0-3.2 1.3-6.2 3.8-8.8z" />
            <path d="M9.3 20.5h5.4" opacity=".7" />
            break;

        case "birthday":
            @* A single candle on a small cake. *@
            <path d="M5.4 19.6v-4.2a2 2 0 0 1 2-2h9.2a2 2 0 0 1 2 2v4.2z" />
            <path d="M4.4 19.6h15.2" />
            <path d="M12 13.4v-3.2" />
            <path d="M12 9.8c1-.9 1-2.1 0-3-1 .9-1 2.1 0 3z" fill="currentColor" stroke="none" opacity=".8" />
            break;

        case "fathers-day":
            @* A bow tie. *@
            <path d="M10.4 9.6 4.6 7.2v9.6l5.8-2.4z" />
            <path d="M13.6 9.6 19.4 7.2v9.6l-5.8-2.4z" />
            <rect x="10.4" y="9.6" width="3.2" height="4.8" rx="1" />
            break;

        case "mothers-day":
            @* A tulip, the flower given on Persian Mother's Day. *@
            <path d="M12 12.6c-2.2 0-3.8-1.8-3.8-4.2 1.4 0 2.6.6 3.8 1.8 1.2-1.2 2.4-1.8 3.8-1.8 0 2.4-1.6 4.2-3.8 4.2z" />
            <path d="M12 12.6v7.4" />
            <path d="M12 16.4c-1.6 0-2.8-1-3.2-2.6 1.6-.2 2.8.8 3.2 2.6z" opacity=".7" />
            break;

        case "students-day":
            @* A graduation cap. *@
            <path d="M12 5.4 3.4 9.2 12 13l8.6-3.8z" />
            <path d="M7.2 11v4.4c0 1.4 2.2 2.6 4.8 2.6s4.8-1.2 4.8-2.6V11" />
            <path d="M20.6 9.2v4.4" opacity=".7" />
            break;

        default:
            <circle cx="12" cy="12" r="7" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Slug { get; set; } = "";
}
