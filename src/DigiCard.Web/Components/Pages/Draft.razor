@page "/drafts/{Id:guid}"
@using System.Security.Claims
@using DigiCard.Contracts.Templates
@using DigiCard.Web.Client.Components
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject DigiCard.Contracts.Invitations.IDraftReader Reader
@inject ITemplateCatalog Catalog
@inject AuthenticationStateProvider Authentication

@* Private page: kept out of the index, and never cached by a shared proxy. The authorization
   attribute and the owner-scoped read below are what actually protect it. *@
<SeoHead Title="پیش‌نویس کارت | دیجی‌کارت" NoIndex="true" />

@if (draft is null)
{
    <header class="page-head">
        <h1>پیش‌نویس پیدا نشد</h1>
        <p>این پیش‌نویس وجود ندارد یا متعلق به حساب شما نیست.</p>
    </header>
    <p><a class="btn-primary" href="/studio">ساخت کارت جدید</a></p>
}
else
{
    <nav class="breadcrumb" aria-label="مسیر صفحه">
        <ol>
            <li><a href="/">خانه</a></li>
            <li aria-current="page">پیش‌نویس</li>
        </ol>
    </nav>

    <header class="page-head">
        <h1>@draft.Title</h1>
        <p role="status">پیش‌نویس ذخیره شد؛ فقط برای شما قابل مشاهده است.</p>
    </header>

    <div class="detail-grid">
        <div class="detail-preview">
            @* The draft snapshotted its accent at creation time. The rest of the design is read
               from the catalog, so a template redesign is visible here. A fully independent
               snapshot belongs to the publish step, not to drafts. *@
            @* The draft's own saved arrangement wins over the template's: editing a template
               must not move the names on a card someone already saved. *@
            <CardPreview Template="template"
                         ElementsOverride="@draft.Elements"
                         AccentOverride="@draft.Accent"
                         EventDate="@draft.EventDate"
                         EventTime="@draft.EventTime"
                         EventEndTime="@draft.EventEndTime"
                         Address="@draft.Address"
                         BrideName="@draft.BrideName"
                         GroomName="@draft.GroomName"
                         Message="@draft.Message" />
        </div>

        <div class="detail-info">
            <dl class="detail-specs">
                <div>
                    <dt>قالب</dt>
                    <dd>@(template?.Name ?? "قالب حذف شده")</dd>
                </div>
                <div>
                    <dt>نسخه قالب هنگام ساخت</dt>
                    <dd>@draft.TemplateVersion</dd>
                </div>
                <div>
                    <dt>تاریخ ساخت</dt>
                    <dd>@draft.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</dd>
                </div>
            </dl>

            @if (template is not null && template.Version != draft.TemplateVersion)
            {
                <p class="detail-note">
                    این قالب از زمان ساخت پیش‌نویس به‌روزرسانی شده است (نسخه @template.Version).
                    آنچه اینجا می‌بینید طرح جدید است.
                </p>
            }

            <a class="btn-primary" href="/studio">ساخت کارت دیگر</a>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private DigiCard.Contracts.Invitations.DraftResponse? draft;
    private TemplateSummary? template;

    protected override async Task OnParametersSetAsync()
    {
        if (HttpContext is not null) HttpContext.Response.Headers.CacheControl = "no-store";

        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        var owner = user.FindFirstValue(ClaimTypes.NameIdentifier);

        // Ownership is enforced in the query itself; an id alone is never enough.
        draft = string.IsNullOrWhiteSpace(owner)
            ? null
            : await Reader.FindOwnedAsync(Id, owner, CancellationToken.None);

        template = draft is null
            ? null
            : await Catalog.FindAsync(draft.TemplateId, CancellationToken.None);
    }
}
