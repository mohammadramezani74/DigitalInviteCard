@inherits LayoutComponentBase
@layout DigiCard.Web.Components.Layout.MainLayout
@inject NavigationManager NavigationManager

@* The scaffolded account pages are written in Bootstrap's classes and nothing else on the site
   is, so it is loaded here instead of in the page head. These pages carry a noindex and are
   reached by a handful of people a day; the front page is reached by everyone. When these pages
   are redesigned in the site's own styles, this line and the package go together. *@
<HeadContent>
    <link rel="stylesheet" href="@Assets["bootstrap/bootstrap.min.css"]" />
</HeadContent>

@if (HttpContext is null)
{
    <p>Loading...</p>
}
else
{
    @Body
}

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    protected override void OnParametersSet()
    {
        if (HttpContext is null)
        {
            // If this code runs, we're currently rendering in interactive mode, so there is no HttpContext.
            // The identity pages need to set cookies, so they require an HttpContext. To achieve this we
            // must transition back from interactive mode to a server-rendered page.
            NavigationManager.Refresh(forceReload: true);
        }
    }
}
